# Copy this file to ".env" in the same folder and fill in your own values.
# ".env" is ignored by git, so your real secrets never get committed.

# Supabase (Project Settings -> API): the project URL and the publishable key (sb_publishable_...).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=

# Supabase database (Connect button -> Session pooler). Use the JDBC form of the address.
# The user for the pooler is "postgres.YOUR-PROJECT-REF".
DB_URL=jdbc:postgresql://YOUR-POOLER-HOST:5432/postgres
DB_USER=postgres.YOUR-PROJECT-REF
DB_PASSWORD=

# TMDB "API Read Access Token" (themoviedb.org -> Settings -> API).
TMDB_TOKEN=

# Optional. These have defaults that suit running on your own computer.
# On a real server: COOKIE_SECURE=true (needs HTTPS). The host usually sets PORT itself.
# COOKIE_SECURE=false
# DB_POOL_SIZE=3
# PORT=8080
